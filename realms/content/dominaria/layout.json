      "style": "llanowar",
      "start": true,
      "home": "G",
      "inn": "The Hollow Bough",
      "innkeeper": ["Welcome to the elfhames. The trees are listening; tip accordingly."],
      "board": ["Bounty: the wurm eating the north orchard.", "The Steel Leaf ride at dawn. Stay off the trails."],
      "folk": [
        {
          "name": "Elvish ranger",
          "text": ["Across the Suder the forest begins, and it does not end politely."]
