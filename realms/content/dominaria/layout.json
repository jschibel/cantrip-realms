  "towns": [
    {
      "id": "new-argive",
      "name": "New Argive",
      "kind": "capital",
      "region": "argive",
      "style": "argive",
      "at": [320, 320],
      "radius": 60,
      "inn": "The Gilded Sprocket",
      "innkeeper": ["Welcome to New Argive. Rooms are free for mages; the Argivians are grateful, or say so."],
      "board": ["The five color-wells of Dominaria are held by guardians. Earn each well's attunement.", "When all five are yours, the Phyrexian Portal south of the city will open. So say the seers.", "The mage towers' waystones carry those who beat their mages from tower to tower.", "The arena opens soon. Practise your duelling."],
      "folk": [
        {
          "name": "Argivian scholar",
          "text": ["Every road leads here, and every road leads away. Pick one."]
        },
        {
          "name": "Town crier",
          "text": ["Hear ye! Phyrexian stragglers sighted in every region! Arm yourselves with cards!"]
        },
        {
          "name": "Merchant",
          "text": ["Eight vendors in one city. Nowhere else on Dominaria can say that."]
        },
        {
          "name": "Old soldier",
          "text": ["The farther from the walls, the worse the things out there. The waymarkers tell you how bad."]
        },
        {
          "name": "Dock porter",
          "text": ["The Portal's road runs south out of the gate. Nobody comes back up it."]
        }
      ],
      "centrepiece": "statue",
      "start": true,
      "temple": "The Temple of the Thran",
      "guild": "The Argivian Mages' Guild"
    },
    {
      "id": "new-benalia",
      "name": "New Benalia",
      "kind": "town",
      "region": "benalia",
      "style": "benalish",
      "at": [198, 275],
      "radius": 40,
      "inn": "The Shining Shield",
      "innkeeper": ["Welcome to New Benalia, mage. Rest here, and here you wake if a duel goes badly."],
      "board": ["Bounty: Phyrexian scouts in the Benalish Farmlands.", "Wanted: an escort to Capashen Hold."],
      "folk": [
        {
          "name": "Benalish squire",
          "text": ["The Capashens say the meadow's scouts are Phyrexian. Stragglers, I hope."]
        },
        {
          "name": "Old pilgrim",
          "text": ["Serra's sanctum fell with her realm. Its angels guard it still, but not for her."]
        }
      ],
      "centrepiece": "statue",
      "start": true,
      "home": "W",
      "temple": "The Cathedral of Serra",
      "guild": "The Order of the White Shield"
    },
