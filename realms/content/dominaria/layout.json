  "towns": [
    {
      "id": "new-benalia",
      "name": "New Benalia",
      "kind": "capital",
      "region": "benalia",
      "style": "benalish",
      "start": true,
      "inn": "The Gilded Sword",
      "innkeeper": ["Welcome to New Benalia, mage. The capital rests easier with your kind about."],
      "board": ["The five color-wells of the Domains are held by guardians. Earn each well's attunement.", "When all five are yours, the Phyrexian Portal in the desolate waste will open. So say the seers.", "The mage towers' waystones carry those who beat their mages from tower to tower.", "The arena opens soon. Practise your duelling."],
      "folk": [
        {
          "name": "Benalish herald",
          "text": ["Every road in Aerona leads to New Benalia. Most of them come back."]
        },
        {
          "name": "Town crier",
          "text": ["Hear ye! Phyrexian stragglers in every Domain! Arm yourselves with cards!"]
        },
        {
          "name": "Merchant",
          "text": ["More vendors here than anywhere in the Domains, and a shop of wares from other planes."]
        },
        {
          "name": "Old soldier",
          "text": ["Past the Hurloons the wilds turn hard. The waymarkers say how hard."]
        },
        {
          "name": "Caravan master",
          "text": ["The planeswalkers' caravans come and go. Watch the market square."]
        }
      ],
      "centrepiece": "statue",
      "temple": "The Cathedral of Serra",
      "guild": "The Order of the White Shield",
      "exotic": "new-benalia-exotic-wares",
      "caravan": true,
      "at": [368, 338],
      "radius": 66
    },
    {
      "id": "capashen-hold",
      "name": "Capashen Hold",
      "kind": "town",
      "region": "benalia",
      "style": "benalish",
      "start": true,
      "home": "W",
      "inn": "The Capashen Arms",
      "innkeeper": ["Welcome to Capashen Hold, mage. Rest here, and here you wake if a duel goes badly."],
      "board": ["Bounty: Phyrexian scouts in the Benalish Farmlands.", "Wanted: an escort to the Fallen Keep."],
      "folk": [
        {
          "name": "Benalish squire",
          "text": ["The Capashens held this land before New Benalia stood."]
        },
        {
          "name": "Old pilgrim",
          "text": ["Serra's angels guard the fallen keep still, but not for her."]
        }
      ],
      "centrepiece": "statue",
      "temple": "The Chapel of the Capashens",
      "guild": "The Hold's Mages' Hall",
      "exotic": "capashen-hold-exotic-wares",
      "caravan": true,
      "at": [344, 475],
      "radius": 42
    },
