{
  "name": "cantrip-realms-web",
  "private": true,
  "type": "module",
  "description": "Cantrip Realms' overworld: the isometric, pixel-rendered world the card layer opens over.",
  "scripts": {
    "theme": "node scripts/theme.mjs",
    "dev": "node scripts/theme.mjs && vite",
    "build": "node scripts/theme.mjs && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "models": "vite-node scripts/models.ts",
    "world": "vite-node scripts/world.ts",
    "e2e": "node scripts/theme.mjs && playwright test -c e2e/playwright.config.ts",
    "e2e:server": "node scripts/theme.mjs && playwright test -c e2e/server/playwright.config.ts",
    "world:map": "vite-node scripts/world-map.ts",
    "bench": "node scripts/theme.mjs && playwright test -c e2e/bench/playwright.config.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
